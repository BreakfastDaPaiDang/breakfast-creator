# Copy to .env only when a workflow needs a remote provider.
# Never commit the real file.

# Reasoning / scripts
OPENAI_API_KEY=

# Image and video generation (enable providers only when selected)
FAL_KEY=
KLING_API_KEY=
GOOGLE_API_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
HEYGEN_API_KEY=

# Voice and music
ELEVENLABS_API_KEY=

# Licensed/free media search
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Comment Scout: read-only Bilibili access. Set locally; never pass in CLI arguments.
# Paste the Cookie request-header value, including SESSDATA, into the local .env.
BILIBILI_COOKIE=

# Zhihu Scout: read-only requests. Agent stores user-provided Cookie in local .env.
# Required fields for initial testing: z_c0 and d_c0; retain _xsrf if present.
ZHIHU_COOKIE=
